DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-unique-random-value-at-least-50-characters-long

# Railway normally supplies DATABASE_URL when PostgreSQL is attached.
DATABASE_URL=postgresql://user:password@host:5432/database

# Comma-separated hostnames only; do not include schemes or paths.
ALLOWED_HOSTS=api.example.com

# Comma-separated browser origins, including https:// and no trailing slash.
FRONTEND_ORIGINS=https://app.example.com

# Secure sliding session timeout. Default: 12 hours (43200 seconds).
SESSION_COOKIE_AGE_SECONDS=43200
SESSION_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# Login protection. Django REST Framework rate syntax supports second/minute/hour/day.
LOGIN_IP_RATE=20/min
LOGIN_ACCOUNT_RATE=5/min

# Production web process tuning. Railway supplies PORT automatically.
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT_SECONDS=120
# Optional human-readable release; Railway's commit SHA is used when omitted.
ATLAS_RELEASE=

# Logs are JSON on stdout. Requests at or above this duration are warnings.
LOG_LEVEL=INFO
ATLAS_SLOW_REQUEST_MS=1000
ATLAS_REQUEST_LOGGING=True

# Mount a persistent Railway volume here before scheduling supplemental backups.
ATLAS_BACKUP_DIR=/data/backups

# Start conservatively during beta; increase after the HTTPS setup is stable.
SECURE_HSTS_SECONDS=3600

ATLAS_V2_ENABLED=True
OPTIMIZER_MAX_CONCURRENT_RUNS_PER_VERSION=2
OPTIMIZER_ENABLE_PARALLEL_ISOLATION=True
